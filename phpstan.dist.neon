parameters:
    level: max
    phpVersion:
        min: 80600
        max: 80699
    paths:
        - SettingBundle.php
        - Command
        - Definition
        - DependencyInjection
        - Doctrine
        - Event
        - Exception
        - Resolver
        - Scope
        - Store
        - Translation
        - Writer
        - Tests
        - rector.php
    treatPhpDocTypesAsCertain: false

    # Le niveau max dès le premier jour, et sans baseline : une brique extraite avec une
    # baseline arrive avec sa dette déjà tolérée, et personne ne la reprend ensuite.
