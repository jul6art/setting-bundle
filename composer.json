{
    "name": "jul6art/setting-bundle",
    "type": "symfony-bundle",
    "description": "Settings declared in code, overridden in cascade, changed hot",
    "homepage": "https://github.com/jul6art/setting-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jul6Art",
            "email": "admin@devinthehood.com",
            "homepage": "https://devinthehood.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "psr/cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.5",
        "rector/rector": "^2.8.3",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/var-dumper": "^7.4 || ^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To keep the values in the application's table (setting.storage.value_class)",
        "doctrine/orm": "To keep the values in the application's table (setting.storage.value_class)",
        "symfony/console": "For setting:set, which sets a value from the command line"
    },
    "autoload": {
        "psr-4": {
            "Jul6Art\\SettingBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jul6Art\\SettingBundle\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "symfony": {
            "require": "7.4.*"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "test": "phpunit",
        "qa": [
            "@cs-check",
            "@rector-check",
            "@phpstan",
            "@test"
        ]
    }
}
